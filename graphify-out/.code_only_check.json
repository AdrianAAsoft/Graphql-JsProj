import json
from pathlib import Path

result = json.loads(Path('graphify-out/.graphify_incremental.json').read_text(encoding='utf-8'))
code_exts = {'.py','.ts','.js','.go','.rs','.java','.cpp','.c','.rb','.swift','.kt','.cs','.scala','.php','.cc','.cxx','.hpp','.h','.kts','.lua','.toc'}
new_files = result.get('new_files', {})
all_changed = [f for files in new_files.values() for f in files]
code_only = all(len(Path(f).suffix.lower())>0 and Path(f).suffix.lower() in code_exts for f in all_changed)
summary = {
  'changed_count': len(all_changed),
  'code_only': code_only,
  'sample_files': [Path(f).name for f in all_changed[:8]]
}
print(json.dumps(summary, ensure_ascii=False))
